<Window x:Class="AppProj.NovaEstacio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Estacio" Height="220" Width="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="55"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Label Content="Nom:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"></Label>
        <TextBox x:Name="txtNom" Grid.Row="0" Grid.Column="1" Height="25" Margin="3" VerticalAlignment="Center" TextChanged="txt_TextChanged"></TextBox>

        <Label Content="Latitud:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"></Label>
        <TextBox x:Name="txtLatitud" Grid.Row="0" Grid.Column="3" Height="25" Margin="3" VerticalAlignment="Center" TextChanged="txt_TextChanged"></TextBox>

        <Label Content="Ciutat:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"></Label>
        <TextBox x:Name="txtCiutat" Grid.Row="1" Grid.Column="1" Height="25" Margin="3" VerticalAlignment="Center" TextChanged="txt_TextChanged"></TextBox>

        <Label Content="Longitud:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"></Label>
        <TextBox x:Name="txtLongitud" Grid.Row="1" Grid.Column="3" Height="25" Margin="3" VerticalAlignment="Center" TextChanged="txt_TextChanged"></TextBox>
        
        <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btCancelar" Width="95" Height="27" Margin="3" Click="btCancelar_Click">Cancelar</Button>
            <Button x:Name="btGuardarCanvis" Width="100" Height="27" Margin="3" Click="btGuardarCanvis_Click">Guardar Canvis</Button>
        </StackPanel>
    </Grid>
</Window>