<Window x:Class="AppProj.SignIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppProj"
        mc:Ignorable="d"
        Title="Registre" Height="450" Width="350">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Button HorizontalAlignment="Left" VerticalAlignment="Center" Click="btReturn_Click">Return</Button>

            <Label Grid.Column="1" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">Sign In</Label>
        </StackPanel>

        <StackPanel Grid.Row="1" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label>Email:</Label>
            <TextBox x:Name="txtEmail"/>

            <Label>Nom:</Label>
            <TextBox x:Name="txtNom"/>

            <Label>Password:</Label>
            <PasswordBox x:Name="txtPassword" Height="28" Margin="0,0,0,10"/>

            <Button Width="90" HorizontalAlignment="Center" x:Name="btRegistrar" Click="btRegistrar_Click">Registrar</Button>
        </StackPanel>
    </Grid>
</Window>
