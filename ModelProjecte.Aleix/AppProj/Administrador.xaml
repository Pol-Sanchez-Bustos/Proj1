<Window x:Class="AppProj.Administrador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppProj"
        mc:Ignorable="d"
        Title="Administrador" Height="650" Width="950" MinHeight="550" MinWidth="850"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="Padding" Value="10,4"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="Padding" Value="5"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Top"></Setter>
        </Style>

        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="Margin" Value="5"></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" HorizontalAlignment="Right">
            <MenuItem Header="Consultar" x:Name="mnConsultar" Click="mnConsultar_Click"></MenuItem>
            <MenuItem Header="Log Out" x:Name="mnLogOut" Click="mnLogOut_Click"></MenuItem>
        </Menu>

        <DataGrid x:Name="dtgAdministradors" Grid.Row="2" Margin="5" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="2*"></DataGridTextColumn>
                <DataGridTextColumn Header="Correu electrònic" Binding="{Binding Email}" Width="2*"></DataGridTextColumn>
                <DataGridTextColumn Header="Data de registre" Binding="{Binding DataRegistre}" Width="2*"></DataGridTextColumn>
                <DataGridTextColumn Header="Tipus" Binding="{Binding Tipus}" Width="*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="5" VerticalAlignment="Center">Trajectes no visibles</Label>
                <ComboBox Grid.Row="1" x:Name="cmbTrajectesNoVisibles" Height="30" HorizontalAlignment="Left" Width="150" IsEnabled="False"></ComboBox>
                <TextBox Grid.Row="2" x:Name="txtTrajectesNoVisibles" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"></TextBox>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5">
                <Button x:Name="btValidar" FontSize="20" Width="45" Height="40" IsEnabled="False">❯</Button>
                <Button x:Name="btDesvalidar" FontSize="20" Width="45" Height="40" IsEnabled="False">❮</Button>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="5" VerticalAlignment="Center">Trajectes validats</Label>
                <ComboBox Grid.Row="1" x:Name="cmbTrajectesValidats" Height="30" HorizontalAlignment="Left" Width="150" IsEnabled="False"></ComboBox>
                <TextBox Grid.Row="2" x:Name="txtTrajectesValidats" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"></TextBox>
            </Grid>
        </Grid>
    </Grid>
</Window>