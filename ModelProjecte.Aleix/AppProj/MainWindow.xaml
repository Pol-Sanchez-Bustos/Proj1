<Window x:Class="AppProj.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppProj"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="Margin" Value="5"></Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,20,0"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="1.5*"></ColumnDefinition>
            <ColumnDefinition Width="1.5*"></ColumnDefinition>
            <ColumnDefinition Width="1.5*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto" MinHeight="200"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Menu Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.ColumnSpan="5">
            <MenuItem Header="Sign in" x:Name="mnSignIn" Click="mnSignIn_Click"></MenuItem>
            <MenuItem Header="Log in" x:Name="mnLogIn" Click="mnLogIn_Click"></MenuItem>
            <MenuItem Header="Editar" x:Name="mnEdit" Click="mnEdit_Click" Visibility="Collapsed"></MenuItem>
            <MenuItem Header="Administrar" x:Name="mnAdmin" Click="mnAdmin_Click" Visibility="Collapsed"></MenuItem>
            <MenuItem Header="Log out" x:Name="mnLogOut" Click="mnLogOut_Click" Visibility="Collapsed"></MenuItem>
        </Menu>

        <Label Grid.Column="0" Grid.Row="1" Margin="0,0,0,10">Origen:</Label>
        <Label Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">Desti:</Label>
        <Label Grid.Column="3" Grid.Row="1" Margin="0,0,0,10">Hora de sortida:</Label>

        <TextBox Grid.Column="0" Grid.Row="2" x:Name="txtOrigen" KeyDown="txtOrigen_KeyDown" TextChanged="txtOrigen_TextChanged" GotFocus="txtOrigen_GotFocus"></TextBox>
        <Popup x:Name="popupSugerenciasOrigen" 
           PlacementTarget="{Binding ElementName=txtOrigen}" 
           Placement="Bottom" 
           StaysOpen="False">
            <ListBox x:Name="lstSugerenciasOrigen"
             MaxHeight="150"
             Width="{Binding ActualWidth, ElementName=txtOrigen}"
             SelectionChanged="lstSugerenciasOrigen_SelectionChanged">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Nom}"
                       Foreground="Black"
                       Padding="5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Popup>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtDesti" KeyDown="txtDesti_KeyDown" TextChanged="txtDesti_TextChanged" GotFocus="txtDesti_GotFocus"/>
        <Popup x:Name="popupSugerenciasDesti" 
           PlacementTarget="{Binding ElementName=txtDesti}" 
           Placement="Bottom" 
           StaysOpen="False">
            <ListBox x:Name="lstSugerenciasDesti"
         MaxHeight="150"
         Width="{Binding ActualWidth, ElementName=txtDesti}"
         SelectionChanged="lstSugerenciasDesti_SelectionChanged">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Nom}"
                       Foreground="Black"
                       Padding="5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Popup>
        <Button Grid.Column="2" Grid.Row="2" Margin="10,0,10,0" x:Name="btBuscarTrajecte" Click="btBuscarTrajecte_Click">Buscar Trajecte</Button>
        <TextBox Grid.Column="3" Grid.Row="2" x:Name="txtSortida" KeyDown="txtSortida_KeyDown"></TextBox>

        <Label Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,5">Trajectes:</Label>
        <Label Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="3" Margin="10,10,0,5">Trajectes amb transbords:</Label>
        <DataGrid Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Visible" Margin="0,0,5,0" SelectionMode="Single" x:Name="dtgTrajectes" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="dtgTrajectes_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Trajecte" Binding="{Binding Trajecte1.Nom}" Width="2*"></DataGridTextColumn>
                <DataGridTextColumn Header="Mitja" Binding="{Binding Trajecte1.Mitja.Nom}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Mitja" Binding="{Binding HoraSortidaFormat}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Mitja" Binding="{Binding HoraArribadaFormat}" Width="*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Visible" Margin="5,0,0,0" SelectionMode="Single" x:Name="dtgTransbords" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="dtgTransbords_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Trajecte 1" Binding="{Binding Trajecte1.Nom}" Width="2*"></DataGridTextColumn>
                <DataGridTextColumn Header="Trajecte 2" Binding="{Binding Trajecte2.Nom}" Width="2*"></DataGridTextColumn>
                <DataGridTextColumn Header="Sortida" Binding="{Binding HoraSortidaFormat}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Arribada" Binding="{Binding HoraArribadaFormat}" Width="*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBox Grid.Column="0" Grid.Row="5" Margin="10" Grid.ColumnSpan="3" IsReadOnly="True" Name="txtTrajecte" Visibility="Collapsed"></TextBox>
    </Grid>

</Window>
