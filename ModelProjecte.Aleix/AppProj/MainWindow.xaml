<Window x:Class="AppProj.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppProj"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="Margin" Value="5"></Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,20,0"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>

        </Style>
    </Window.Resources>




    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"></ColumnDefinition>
            <ColumnDefinition Width="10*"></ColumnDefinition>
            <ColumnDefinition Width="15*"></ColumnDefinition>
            <ColumnDefinition Width="10*"></ColumnDefinition>
            <ColumnDefinition Width="12*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="44*"></RowDefinition>
            <RowDefinition Height="44*"></RowDefinition>
            <RowDefinition Height="31*"></RowDefinition>
            <RowDefinition Height="13*"/>
            <RowDefinition Height="44*"></RowDefinition>
            <RowDefinition Height="219*"></RowDefinition>

        </Grid.RowDefinitions>

        <Menu Grid.Column="4" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" >
            <MenuItem Header="Sign in" >Sign In</MenuItem>
            <MenuItem Header="Log in">Log In</MenuItem>
            <MenuItem Header="Editor" Visibility="Collapsed"></MenuItem>
            <MenuItem Header="Log out" Visibility="Collapsed"></MenuItem>
        </Menu>

        <Label Grid.Column="0" Grid.Row="1" Margin="0,0,0,30" Grid.RowSpan="2">Origen:</Label>
        <Label Grid.Row="1" Grid.ColumnSpan="3" Margin="133,0,200,30" Grid.RowSpan="2">Desti:</Label>
        <Label Grid.Column="3" Grid.Row="1" Margin="0,0,0,30" Grid.RowSpan="2">Hora de sortida:</Label>

        <TextBox Grid.Column="0" Grid.Row="2" Margin="0,0,20,0" Grid.RowSpan="2" x:Name="txtOrigen"></TextBox>
        <TextBox Grid.Row="2" Grid.ColumnSpan="2" Margin="133,0,20,0" Grid.RowSpan="2" x:Name="txtDesti"/>
        <Button Grid.Column="2" Grid.Row="2" Margin="10,0,10,0" Grid.RowSpan="2" x:Name="btBuscarTrajecte" Click="btBuscarTrajecte_Click">Buscar Trajecte</Button>
        <TextBox Grid.Column="3" Grid.Row="2" Margin="0,0,20,0" Grid.RowSpan="2" x:Name="txtSortida"></TextBox>

        <Label Grid.Column="0" Grid.Row="3" Margin="0,13,0,0" Grid.RowSpan="2">Trajectes:</Label>
        <DataGrid Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="5" VerticalScrollBarVisibility="Visible" Margin="0,44,0,0" Grid.RowSpan="2" x:Name="dtgTrajectes">

        </DataGrid>
    </Grid>

</Window>
