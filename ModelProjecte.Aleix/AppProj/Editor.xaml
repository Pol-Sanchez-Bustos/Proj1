<Window x:Class="AppProj.Editor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppProj"
        mc:Ignorable="d"
        Title="Editor" Height="650" Width="950" MinHeight="550" MinWidth="850"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="Padding" Value="10,4"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="Padding" Value="5"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        </Style>

        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="Margin" Value="5"></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" HorizontalAlignment="Right">
            <MenuItem Header="Consultar" x:Name="mnConsultar" Click="mnConsultar_Click"></MenuItem>
            <MenuItem Header="Log Out" x:Name="mnLogOut" Click="mnLogOut_Click"></MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*"></ColumnDefinition>
                <ColumnDefinition Width="45*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="6*"></RowDefinition>
                    <RowDefinition Height="5*"></RowDefinition>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button x:Name="btNouTrajecte" Click="btNouTrajecte_Click">Nou Trajecte</Button>
                    <Button x:Name="btEliminarTrajecte" IsEnabled="False" Click="btEliminarTrajecte_Click">Eliminar Trajecte</Button>
                </StackPanel>

                <DataGrid x:Name="dtgTrajectes" Grid.Row="1" Margin="5" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="dtgTrajectes_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*"></DataGridTextColumn>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="2*"></DataGridTextColumn>
                        <DataGridTextColumn Header="Mitja Transport" Binding="{Binding Mitja.Nom}" Width="2*"></DataGridTextColumn>
                        <DataGridTextColumn Header="Data Creacio" Binding="{Binding DataCreacio, StringFormat={}{0:dd/MM/yyyy}}" Width="2*"></DataGridTextColumn>
                        <DataGridTemplateColumn Header="Validat" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Label>
                                        <Style TargetType="Label">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Validat}" Value="1">
                                                    <Setter Property="Content" Value="Si"></Setter>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Validat}" Value="0">
                                                    <Setter Property="Content" Value="No"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="dtgParades" Grid.Column="0" Margin="5" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="dtgParades_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Posicio" Binding="{Binding Ordre}" Width="1*"></DataGridTextColumn>
                            <DataGridTextColumn Header="Estacio" Binding="{Binding Estacio.Nom}" Width="2*"></DataGridTextColumn>
                            <DataGridTextColumn Header="Hora Sortida" Binding="{Binding HoraPasFormat}" Width="2*"></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5">
                        <Button x:Name="btNovaParada" Margin="5,15,5,5" IsEnabled="False" Click="btNovaParada_Click">Nova Parada</Button>

                        <Button x:Name="btEliminarParada" Margin="5,15,5,5" IsEnabled="False" Click="btEliminarParada_Click">Eliminar</Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="3*"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Border Grid.Row="1" Margin="5" BorderBrush="Black" BorderThickness="1" CornerRadius="15" Padding="10">
                    <Grid Grid.Row="0" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0" VerticalAlignment="Center">Nom</Label>
                        <TextBox Grid.Column="1" x:Name="txtNom" Width="150" HorizontalAlignment="Left" IsEnabled="False"></TextBox>

                        <Label Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">Mitja Transport</Label>
                        <ComboBox Grid.Column="1" Grid.Row="1" x:Name="cbMitjaTransport" Width="150" HorizontalAlignment="Left" IsEnabled="False" DisplayMemberPath="Nom"></ComboBox>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btCancelaTraj" IsEnabled="False" VerticalAlignment="Top" Click="btCancelaTraj_Click">Cancela canvis</Button>
                    <Button x:Name="btGuardarCanvisTraj" IsEnabled="False" VerticalAlignment="Top" Click="btGuardarCanvisTraj_Click">Guardar Canvis</Button>
                </StackPanel>

                <Border Grid.Row="3" Margin="5" BorderBrush="Black" BorderThickness="1" CornerRadius="15" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="2">
                            <Button x:Name="btPuja" Width="55" IsEnabled="False" Click="btPuja_Click">Puja</Button>
                            <Button x:Name="btBaixa" Width="55" IsEnabled="False" Click="btBaixa_Click">Baixa</Button>
                        </StackPanel>

                        <Label Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">Estacio:</Label>
                        <TextBox Grid.Column="1" Grid.Row="1" x:Name="txtEstacio" Width="150" IsEnabled="False"></TextBox>

                        <Button Grid.Column="2" Grid.Row="1" x:Name="btNovaEstacio" HorizontalAlignment="Left" IsEnabled="True" Click="btNovaEstacio_Click">Nova Estacio</Button>

                        <Label Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">Hora</Label>
                        <TextBox Grid.Column="1" Grid.Row="2" x:Name="txtHora" Width="150" HorizontalAlignment="Left" IsEnabled="False"></TextBox>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btCancelaPar" IsEnabled="False" VerticalAlignment="Top" Click="btCancelaPar_Click">Restableix parades</Button>
                    <Button x:Name="btGuardarCanvisPar" IsEnabled="False" VerticalAlignment="Top" Click="btGuardarCanvisPar_Click">Guardar Canvis</Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
